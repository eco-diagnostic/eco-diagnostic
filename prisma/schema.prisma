// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Pillar {
  ENERGIA
  AGUA
  RESIDUOS
  MATERIAIS
  GESTAO
}

enum InstitutionSize {
  MICRO
  PEQUENA
  MEDIA
  GRANDE
  INSTITUICAO_ENSINO
  OUTRO
}

enum DiagnosticStatus {
  EM_ANDAMENTO
  CONCLUIDO
  EM_ANALISE
  PENDENTE
}

enum MaturityLevel {
  CRITICO // 0 a 39 pontos
  EM_DESENVOLVIMENTO // 40 a 69 pontos
  AVANCADO // 70 a 89 pontos
  SUSTENTAVEL // 90 a 100 pontos
}

// ==========================================
// MODELS
// ==========================================

/// Instituição / Empresa vinculada ao usuário do Clerk
model Institution {
  id          String          @id @default(cuid())
  userId      String          @unique // ID do usuário autenticado no Clerk
  name        String
  sector      String // Ramo / Setor de atuação (ex: Educação, Saúde, Indústria, Comércio)
  city        String
  state       String? // UF (ex: SP, RJ, MG)
  size        InstitutionSize @default(PEQUENA)
  description String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diagnostics      Diagnostic[]
  generalSummaries GeneralSummary[]

  @@index([userId])
}

/// Banco de perguntas de sustentabilidade por pilar (cadastradas via seed)
model Question {
  id          String   @id @default(cuid())
  pillar      Pillar
  title       String   @db.Text
  description String?  @db.Text
  weight      Float    @default(1.0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options QuestionOption[]
  answers DiagnosticAnswer[]

  @@index([pillar, isActive])
}

/// Alternativas de resposta com pontuação ponderada (0 a 100)
model QuestionOption {
  id               String   @id @default(cuid())
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text             String   @db.Text
  score            Float // Pontuação atribuída (0.0 a 100.0)
  order            Int      @default(0)
  allowsCustomText Boolean  @default(false) // Para opções de texto aberto ("Outro...")
  createdAt        DateTime @default(now())

  answers DiagnosticAnswer[]

  @@index([questionId])
}

/// Instância de um Diagnóstico realizado
model Diagnostic {
  id            String           @id @default(cuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String // ID do usuário do Clerk que realizou o diagnóstico
  status        DiagnosticStatus @default(EM_ANDAMENTO)

  overallScore   Float? // Pontuação final consolidada de 0 a 100
  maturityLevel  MaturityLevel? // Classificação do nível de sustentabilidade
  criticalPillar Pillar? // Principal ponto fraco / pilar com menor nota

  totalQuestions Int       @default(20) // Quantidade de perguntas sorteadas (ex: 4 por pilar)
  answeredCount  Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers      DiagnosticAnswer[]
  pillarScores DiagnosticPillarScore[]
  actionPlan   ActionPlan?

  @@index([institutionId, createdAt])
  @@index([userId])
  @@index([status])
}

/// Resposta de cada pergunta dentro de um diagnóstico
model DiagnosticAnswer {
  id           String      @id @default(cuid())
  diagnosticId String
  diagnostic   Diagnostic  @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  pillar       Pillar // Pilar da pergunta (otimiza consultas e relatórios)

  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  customText    String? @db.Text // Texto customizado caso tenha selecionado campo aberto
  scoreObtained Float // Nota obtida nesta pergunta (0 a 100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([diagnosticId, questionId])
  @@index([diagnosticId])
  @@index([questionId])
  @@index([pillar])
}

/// Snapshot da pontuação consolidada por pilar (para carregamento rápido de gráficos e evolução)
model DiagnosticPillarScore {
  id             String     @id @default(cuid())
  diagnosticId   String
  diagnostic     Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  pillar         Pillar
  score          Float // Nota consolidada do pilar (0 a 100)
  questionsCount Int // Quantidade de perguntas respondidas deste pilar

  createdAt DateTime @default(now())

  @@unique([diagnosticId, pillar])
  @@index([diagnosticId])
}

/// Plano de Ação gerado pelo Gemini (IA) para um diagnóstico específico (salvo para não reprocessar tokens)
model ActionPlan {
  id           String     @id @default(cuid())
  diagnosticId String     @unique
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  content       String  @db.Text // Texto / Markdown completo gerado pela IA com as recomendações
  summary       String? @db.Text // Resumo executivo / síntese
  promptContext String? @db.Text // Contexto / métricas enviadas à IA para rastreabilidade
  aiModel       String? @default("gemini-1.5-flash")
  tokensUsed    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([diagnosticId])
}

/// Resumo Geral gerado pelo Gemini consolidando as análises dos últimos 30 dias
model GeneralSummary {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  content          String   @db.Text // Análise comparativa e plano estratégico de 30 dias da IA
  summary          String?  @db.Text // Síntese rápida
  periodStart      DateTime // Início do intervalo analisado (ex: 30 dias atrás)
  periodEnd        DateTime // Fim do intervalo analisado (data da geração)
  averageScore     Float // Média do índice de sustentabilidade no período
  diagnosticsCount Int // Quantidade de diagnósticos realizados no período

  aiModel    String?  @default("gemini-1.5-flash")
  tokensUsed Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId, createdAt])
}
