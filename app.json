{
  "expo": {
    "name": "Eco Diagnóstico",
    "slug": "eco-diagnostico",
    "scheme": "ecodiagnostico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/avatar-github.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecodiagnostico.app"
    },
    "android": {
      "package": "com.ecodiagnostico.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/avatar-github.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/avatar-github.png"
    },
    "extra": {
      "eas": {
        "projectId": "7e07ea62-1eb1-4e65-b38f-018f30b6e54c"
      }
    },
    "owner": "duuhbraga",
    "plugins": [
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/avatar-github.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-router"
    ]
  }
}
